# Frontend (Vite). Copy to .env.local. Only VITE_* values are exposed to the browser, so never put secrets here.
# Base URL of the Sehat Saathi API (no trailing slash).
# In `npm run dev` this defaults to http://localhost:8000 if unset.
# In a production build it MUST be set, otherwise the app shows a configuration message.
VITE_API_BASE_URL=http://localhost:8000

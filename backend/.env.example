# Copy to .env and edit. Never commit .env.
APP_ENV=development                      # development | production (production disables /docs)
DATABASE_URL=sqlite:///./sehat_saathi.db # PostgreSQL later: postgresql+psycopg://user:pass@host:5432/sehat
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated, exact origins only
# Data Seeding
SEED_SAMPLE_DATA=false                   # Set true only if you want placeholder sample records
SEED_VERIFIED_DATA=true                  # Load legitimate, verified Indian healthcare resources and helplines

# Contact abuse protection
CONTACT_RATE_LIMIT=5                     # max submissions per window per client
CONTACT_RATE_WINDOW_SECONDS=600
CLIENT_HASH_SALT=change-me-to-a-random-string
TRUST_PROXY_HEADERS=false                # true only behind a proxy you control (uses X-Forwarded-For)

# Optional email notification. Leave SMTP_HOST empty to disable (messages are still stored).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
CONTACT_NOTIFY_TO=

# Optional AI Guidance Synthesis (Never required for standard deterministic operation)
# Leaves AI disabled by default. If enabled and GEMINI_API_KEY is supplied, safe grounded synthesis is offered when opted-in.
AI_GUIDANCE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

